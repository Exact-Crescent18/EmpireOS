function getWeekSeed() {
  const now = new Date();
  const day = now.getDay(), h = now.getHours();
  const d = new Date(now);
  let back = day;
  if (day === 0 && h < 18) back = 7;
  d.setDate(d.getDate() - back);
  d.setHours(18, 0, 0, 0);
  return Math.floor(d.getTime() / 1000);
}
function seeded(arr, seed) {
  const a = [...arr]; let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 1664525 + 1013904223) & 0xffffffff;
    const j = Math.abs(s) % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function renderPlatform(plat) {
  const seed = getWeekSeed() * 31 + plat.length;
  const items = seeded(IDEAS[plat], seed).slice(0, 4);
  document.getElementById('grid-' + plat).innerHTML = items.map((x, i) => `
    <div class="idea-card">
      <div class="idea-num">IDEA 0${i+1}</div>
      <div class="idea-title">${x.title}</div>
      <div class="idea-hook">${x.hook}</div>
      <span class="idea-fmt" style="background:var(--laugher-dim);color:var(--laugher)">${x.fmt}</span>
    </div>`).join('');
}
function renderAllIdeas() { ['reels','shorts','stories','collab'].forEach(renderPlatform); }
function switchTab(e, plat) {
