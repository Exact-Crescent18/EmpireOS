}
.add-task-btn:hover { opacity: 0.85; }
.add-task-icon { font-size: 15px; font-weight: 300; line-height: 1; }

/* ── TASK MODAL PANEL ── */
.task-modal {
  position: fixed;
  top: 53px; right: 0;
  width: 420px; max-width: 100vw;
  max-height: calc(100vh - 53px);
  background: var(--card);
  border-left: 1px solid var(--border2);
  border-bottom: 1px solid var(--border2);
  border-bottom-left-radius: 12px;
  box-shadow: -8px 8px 40px rgba(0,0,0,0.6);
  z-index: 190;
  display: flex; flex-direction: column;
  transform: translateX(105%);
  opacity: 0;
  transition: transform 0.28s cubic-bezier(0.4,0,0.2,1), opacity 0.22s ease;
  pointer-events: none;
}
.task-modal.open { transform: translateX(0); opacity: 1; pointer-events: all; }
.task-backdrop {
  position: fixed; inset: 0; z-index: 180;
  background: rgba(0,0,0,0.35);
  opacity: 0; pointer-events: none;
  transition: opacity 0.2s ease;
}
.task-backdrop.open { opacity: 1; pointer-events: all; }

.tm-inner { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
.tm-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 14px 16px 12px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0; position: relative;
}
.tm-header::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--invest), var(--trade), var(--agent));
}
.tm-title {
  font-family: 'Fragment Mono', monospace; font-size: 11px;
  letter-spacing: 0.16em; text-transform: uppercase; color: var(--text);
}
.tm-sub { font-size: 11px; color: var(--dim); margin-top: 2px; }
.tm-header-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.tm-close {
  background: none; border: 1px solid var(--border2); border-radius: 6px;
  color: var(--dim); font-size: 13px; width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.15s; flex-shrink: 0;
}
.tm-close:hover { border-color: #e05252; color: #e05252; }
.tm-form {
  padding: 12px 14px; border-bottom: 1px solid var(--border);
  display: flex; flex-direction: column; gap: 7px; flex-shrink: 0;
}
.tm-list {
  flex: 1; overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: var(--border2) transparent;
}
.tm-list::-webkit-scrollbar { width: 4px; }
.tm-list::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }

/* toggle */
.ca-toggle {
  display: flex; background: var(--card2); border: 1px solid var(--border);
  border-radius: 6px; overflow: hidden;
}
.ca-tog-btn {
  font-family: 'Fragment Mono', monospace; font-size: 9px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--dim); padding: 5px 12px; cursor: pointer;
