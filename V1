}
.ca-tog-btn.active { background: var(--invest); color: #000; font-weight: 700; }

/* inputs */
.ca-text-input {
  width: 100%; background: var(--card2); border: 1px solid var(--border2);
  border-radius: 7px; color: var(--text);
  font-family: 'DM Sans', sans-serif; font-size: 13px;
  padding: 8px 12px; outline: none; transition: border-color 0.15s;
}
.ca-text-input::placeholder { color: var(--dim); }
.ca-text-input:focus { border-color: var(--invest); }
.ca-desc-input { resize: vertical; min-height: 52px; line-height: 1.5; font-size: 12px !important; }
.ca-bottom-row { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; }
.ca-selects { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; }
.ca-select {
  flex: 1; min-width: 100px;
  background: var(--card2); border: 1px solid var(--border2);
  border-radius: 7px; color: var(--text);
  font-family: 'Fragment Mono', monospace; font-size: 10px;
  letter-spacing: 0.05em; padding: 7px 8px; outline: none; cursor: pointer;
  transition: border-color 0.15s;
}
.ca-select:focus { border-color: var(--invest); }
.ca-add-btn {
  background: var(--invest); border: none; border-radius: 7px;
  color: #000; font-family: 'Fragment Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
  font-weight: 700; padding: 8px 16px; cursor: pointer;
  transition: opacity 0.15s; white-space: nowrap; flex-shrink: 0;
}
.ca-add-btn:hover { opacity: 0.85; }

/* task list items */
.ca-empty {
  padding: 20px 16px; font-family: 'Fragment Mono', monospace;
  font-size: 10px; letter-spacing: 0.1em; color: var(--muted); text-align: center;
}
.ct-item {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 11px 14px; border-top: 1px solid var(--border);
  background: var(--card); transition: background 0.15s;
}
.ct-item:hover { background: var(--card2); }
.ct-item.ct-done .ct-text { text-decoration: line-through; color: var(--dim); }
.ct-chk {
  width: 19px; height: 19px; border-radius: 5px;
  border: 1px solid var(--border2); background: var(--card2);
  flex-shrink: 0; margin-top: 2px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.15s;
  font-size: 10px; color: transparent; font-weight: 800;
}
.ct-item.ct-done .ct-chk { background: var(--invest); border-color: var(--invest); color: #000; }
.ct-body { flex: 1; min-width: 0; }
.ct-text { font-size: 13px; font-weight: 500; color: var(--text); line-height: 1.4; }
.ct-desc { font-size: 11px; color: var(--dim); margin-top: 3px; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
.ct-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; align-items: center; }
.ct-badge { font-family: 'Fragment Mono', monospace; font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px; border-radius: 3px; }
.ct-time { font-family: 'Fragment Mono', monospace; font-size: 9px; color: var(--invest); letter-spacing: 0.06em; }
.ct-delete {
  background: none; border: none; color: var(--muted);
  font-size: 15px; cursor: pointer; padding: 0 3px; line-height: 1;
  transition: color 0.15s; flex-shrink: 0; margin-top: 1px;
}
.ct-delete:hover { color: #e05252; }

/* inline custom tasks inside schedule sections */
.custom-inline-section { margin-top: 3px; display: flex; flex-direction: column; gap: 3px; }
.ct-inline {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 11px 15px; background: var(--card);
  border: 1px solid var(--invest); border-radius: 8px;
