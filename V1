  document.querySelectorAll('.ideas-panel').forEach(p => p.classList.remove('active'));
  e.target.classList.add('active');
  document.getElementById('panel-' + plat).classList.add('active');
}

// ── STORAGE ──
const DK = 'eos_daily_v1', DDK = 'eos_daily_date_v1';
const WK = 'eos_weekly_v1', WDK = 'eos_weekly_date_v1';

function getDayId() {
  const n = new Date();
  if (n.getHours() >= 18) {
    const t = new Date(n); t.setDate(t.getDate()+1);
    return t.toDateString() + '_pre';
  }
  return n.toDateString();
}
function getWeekId() {
  const n = new Date(), day = n.getDay(), h = n.getHours();
  const d = new Date(n);
  let back = day;
  if (day === 0 && h < 18) back = 7;
  d.setDate(d.getDate()-back); d.setHours(18,0,0,0);
  return 'w_' + d.toDateString();
}

// ── CLICK HANDLER: expand vs checkbox ──
function hc(event, id) {
  const w = document.getElementById(id);
  if (!w) return;
  const onChk = event.target.classList.contains('chk') || !!event.target.closest('.chk');
  if (onChk) {
    w.classList.toggle('done-wrap');
    id.startsWith('tw') ? (saveWeekly(), updateWeeklyBadge()) : saveDaily();
    updateProgress();
  } else {
    const open = w.classList.contains('open');
    document.querySelectorAll('.tw.open').forEach(x => { if (x !== w) x.classList.remove('open'); });
    w.classList.toggle('open', !open);
  }
}

// ── DAILY ──
function loadDaily() {
  if (localStorage.getItem(DDK) !== getDayId()) {
    localStorage.removeItem(DK);
    localStorage.setItem(DDK, getDayId());
  }
  const s = JSON.parse(localStorage.getItem(DK) || '{}');
  Object.keys(s).forEach(id => { if (s[id]) { const w = document.getElementById(id); if (w) w.classList.add('done-wrap'); } });
  updateProgress();
}
function saveDaily() {
  const s = {};
  document.querySelectorAll('.tw[id^="t"]:not([id^="tw"])').forEach(w => { s[w.id] = w.classList.contains('done-wrap'); });
  localStorage.setItem(DK, JSON.stringify(s));
}
function resetDaily() {
  document.querySelectorAll('.tw[id^="t"]:not([id^="tw"])').forEach(w => w.classList.remove('done-wrap'));
  localStorage.removeItem(DK);
  updateProgress();
}

// ── WEEKLY ──
function loadWeekly() {
  if (localStorage.getItem(WDK) !== getWeekId()) {
    localStorage.removeItem(WK);
    localStorage.setItem(WDK, getWeekId());
  }
  const s = JSON.parse(localStorage.getItem(WK) || '{}');
  Object.keys(s).forEach(id => { if (s[id]) { const w = document.getElementById(id); if (w) w.classList.add('done-wrap'); } });
