<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Empire OS — Daily Command Center</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Fragment+Mono:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #070709;
  --surface: #0f0f12;
  --card: #131318;
  --card2: #18181f;
  --border: #1e1e28;
  --border2: #2a2a38;
  --text: #e8e8f0;
  --dim: #6b6b80;
  --muted: #3a3a4a;

  /* Pillar colors */
  --agent:   #3b82f6;  /* blue   — RE Agent */
  --laugher: #f43f5e;  /* rose   — Laughder */
  --bridge:  #f59e0b;  /* amber  — ServiceBridge */
  --invest:  #10b981;  /* green  — RE Investing */
  --trade:   #a78bfa;  /* purple — Trading */

  --agent-dim:   rgba(59,130,246,0.1);
  --laugher-dim: rgba(244,63,94,0.1);
  --bridge-dim:  rgba(245,158,11,0.1);
  --invest-dim:  rgba(16,185,129,0.1);
  --trade-dim:   rgba(167,139,250,0.1);
}

*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  font-size:14px;
  line-height:1.6;
}

/* ── NAV ── */
.nav{
  position:sticky;top:0;z-index:200;
  background:rgba(7,7,9,0.95);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;
  padding:0 28px;
  gap:0;
}
.nav-logo{
  font-family:'Syne',sans-serif;
  font-size:17px;font-weight:800;
  letter-spacing:0.12em;
  color:var(--text);
  margin-right:32px;
  padding:15px 0;
  flex-shrink:0;
}
.nav-logo span{color:var(--invest);}
.nav-tab{
  font-family:'Fragment Mono',monospace;
  font-size:10px;letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--dim);
  padding:17px 16px;
  cursor:pointer;
  border-bottom:2px solid transparent;
  transition:all 0.18s;
  user-select:none;
  white-space:nowrap;
}
.nav-tab:hover{color:var(--text);}
.nav-tab.active{color:var(--text);border-bottom-color:var(--invest);}
.nav-right{
  margin-left:auto;
  display:flex;align-items:center;gap:12px;
}
.reset-pill{
  display:flex;align-items:center;gap:8px;
  background:var(--card);border:1px solid var(--border);
  border-radius:6px;padding:6px 14px;
}
.reset-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--invest);
  animation:breathe 2.5s ease-in-out infinite;
}
@keyframes breathe{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.4;transform:scale(0.7)}}
.reset-lbl{font-family:'Fragment Mono',monospace;font-size:9px;color:var(--dim);letter-spacing:0.1em;}
.reset-time{font-family:'Fragment Mono',monospace;font-size:13px;color:var(--text);letter-spacing:0.06em;}

/* ── VIEWS ── */
.view{display:none;}
.view.active{display:block;}

/* ════════════════════════════════
   DAILY OS
════════════════════════════════ */
.daily-wrap{max-width:920px;margin:0 auto;padding:32px 20px 80px;}

/* PILLAR STRIP */
.pillar-strip{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:3px;
  margin-bottom:28px;
}
.pillar-chip{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:8px;
  padding:14px 14px 12px;
  position:relative;
  overflow:hidden;
}
.pillar-chip::before{
  content:'';
  position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--pc,#fff);
}
.pc-icon{font-size:18px;margin-bottom:4px;}
.pc-name{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim);margin-bottom:2px;}
.pc-goal{font-size:11px;color:var(--text);font-weight:500;line-height:1.3;}

/* HERO */
.daily-hero{
  margin-bottom:24px;
  display:flex;align-items:flex-start;justify-content:space-between;
  flex-wrap:wrap;gap:16px;
}
.daily-hero-title{
  font-family:'Syne',sans-serif;
  font-size:clamp(30px,5vw,52px);
  font-weight:800;
  line-height:0.95;
  letter-spacing:-0.02em;
  color:#fff;
}
.daily-hero-title span{color:var(--invest);}
.daily-hero-sub{
  font-family:'Fragment Mono',monospace;
  font-size:10px;letter-spacing:0.14em;
  color:var(--dim);text-transform:uppercase;
  margin-top:10px;
}
.hero-stats{display:flex;gap:8px;flex-wrap:wrap;}
.h-stat{
  background:var(--card);border:1px solid var(--border);
  border-radius:7px;padding:10px 16px;text-align:center;
}
.h-stat-val{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:var(--invest);line-height:1;}
.h-stat-lbl{font-family:'Fragment Mono',monospace;font-size:9px;color:var(--dim);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;}

/* RESET BAR */
.reset-bar{
  background:var(--card);border:1px solid var(--border);
  border-left:3px solid var(--invest);
  border-radius:8px;padding:11px 16px;
  margin-bottom:20px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:10px;
}
.reset-bar-txt{font-family:'Fragment Mono',monospace;font-size:10px;color:var(--dim);letter-spacing:0.08em;}
.reset-bar-txt strong{color:var(--invest);}
.manual-btn{
  background:none;border:1px solid var(--border);border-radius:5px;
  color:var(--dim);font-family:'Fragment Mono',monospace;
  font-size:9px;letter-spacing:0.12em;text-transform:uppercase;
  padding:5px 12px;cursor:pointer;transition:all 0.15s;
}
.manual-btn:hover{border-color:var(--dim);color:var(--text);}

/* PROGRESS */
.prog-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:16px 20px;margin-bottom:28px;
}
.prog-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.prog-lbl{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--dim);}
.prog-num{font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:var(--invest);}
.prog-track{height:3px;background:var(--border2);border-radius:99px;overflow:hidden;}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--invest),var(--trade));border-radius:99px;width:0%;transition:width 0.4s ease;}
.prog-msg{font-size:11px;color:var(--dim);margin-top:8px;}

/* SECTION */
.os-section{margin-bottom:28px;}
.sec-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.sec-icon{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.sec-name{font-family:'Fragment Mono',monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text);}
.sec-badge{margin-left:auto;font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.1em;padding:3px 10px;border-radius:4px;}

/* TASK WRAPPERS */
.tasklist{display:flex;flex-direction:column;gap:3px;}
.tw{border-radius:8px;overflow:hidden;border:1px solid var(--border);transition:border-color 0.2s;}
.tw.open{border-color:var(--border2);}
.tw.done-wrap{border-color:rgba(16,185,129,0.2);}

.task-row{
  display:flex;align-items:flex-start;gap:12px;
  padding:13px 15px;background:var(--card);
  cursor:pointer;transition:background 0.15s;user-select:none;
}
.task-row:hover{background:var(--card2);}
.tw.done-wrap .task-row{background:rgba(16,185,129,0.04);}
.tw.done-wrap .t-text{text-decoration:line-through;color:var(--dim);}
.tw.done-wrap .t-sub{color:var(--muted);}

.chk{
  width:19px;height:19px;border-radius:5px;border:1px solid var(--border2);
  background:var(--card2);flex-shrink:0;margin-top:2px;
  display:flex;align-items:center;justify-content:center;
  transition:all 0.15s;font-size:10px;color:transparent;font-weight:800;
}
.tw.done-wrap .chk{background:var(--invest);border-color:var(--invest);color:#000;}

.t-body{flex:1;min-width:0;}
.t-text{font-size:13px;font-weight:500;color:var(--text);line-height:1.4;}
.t-sub{font-size:11px;color:var(--dim);margin-top:2px;line-height:1.5;}
.t-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;}
.t-tag{
  font-family:'Fragment Mono',monospace;font-size:8px;
  letter-spacing:0.1em;text-transform:uppercase;
  padding:2px 7px;border-radius:3px;
}
.arr{
  font-size:10px;color:var(--dim);
  transition:transform 0.25s,color 0.15s;
  flex-shrink:0;padding-top:4px;padding-left:6px;
  margin-left:auto;
}
.tw.open .arr{transform:rotate(180deg);color:var(--invest);}

/* DRAWER */
.drawer{max-height:0;overflow:hidden;transition:max-height 0.38s cubic-bezier(0.4,0,0.2,1);background:#0b0b0e;}
.tw.open .drawer{max-height:1000px;border-top:1px solid var(--border);}
.d-inner{padding:16px 18px 20px;display:flex;flex-direction:column;gap:14px;}
.d-sec{}
.d-lbl{
  font-family:'Fragment Mono',monospace;font-size:8px;
  letter-spacing:0.22em;text-transform:uppercase;color:var(--dim);
  margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid var(--border);
}
.d-bullets{display:flex;flex-direction:column;gap:5px;}
.d-bullet{display:flex;gap:8px;font-size:12px;color:var(--dim);line-height:1.5;}
.d-bullet::before{content:'→';color:var(--invest);font-size:10px;flex-shrink:0;margin-top:3px;}
.d-bullet strong{color:var(--text);}

.d-chips{display:flex;flex-wrap:wrap;gap:6px;}
.d-chip{
  background:var(--card2);border:1px solid var(--border2);
  border-radius:6px;padding:8px 12px;
  font-size:11px;color:var(--dim);line-height:1.4;
  transition:border-color 0.15s,color 0.15s;
  cursor:default;
}
.d-chip:hover{border-color:var(--border2);color:var(--text);}
.d-chip strong{color:var(--text);display:block;font-size:12px;margin-bottom:2px;}

.d-script{
  background:var(--card2);border:1px solid var(--border2);
  border-left:3px solid var(--invest);
  border-radius:6px;padding:11px 13px;
  font-size:12px;color:var(--dim);line-height:1.6;
}
.d-script .slbl{
  font-family:'Fragment Mono',monospace;font-size:8px;
  letter-spacing:0.14em;text-transform:uppercase;
  color:var(--invest);display:block;margin-bottom:5px;
}

/* PILLAR DIVIDERS */
.pillar-divider{
  display:flex;align-items:center;gap:10px;
  margin:4px 0 6px;
}
.pd-dot{width:8px;height:8px;border-radius:50%;}
.pd-name{
  font-family:'Fragment Mono',monospace;font-size:9px;
  letter-spacing:0.16em;text-transform:uppercase;
}
.pd-line{flex:1;height:1px;background:var(--border);}

/* POWER GRID */
.power-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;}
.power-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:8px;padding:14px 14px;
}
.power-card.today-card{
  border-color:var(--bridge);
  background:rgba(245,158,11,0.05);
}
.pw-day{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim);margin-bottom:5px;display:flex;align-items:center;gap:6px;}
.power-card.today-card .pw-day{color:var(--bridge);}
.today-pip{background:var(--bridge);color:#000;font-size:8px;font-weight:700;letter-spacing:0.05em;padding:1px 6px;border-radius:3px;}
.pw-task{font-size:12px;font-weight:500;color:var(--text);line-height:1.4;margin-bottom:3px;}
.pw-note{font-size:11px;color:var(--dim);line-height:1.3;}

/* WEEK STRIP */
.week-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;}
.wk-col{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:13px 11px;}
.wk-col.today-col{border-color:var(--agent);background:var(--agent-dim);}
.wk-name{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim);margin-bottom:8px;}
.wk-col.today-col .wk-name{color:var(--agent);}
.wk-task{font-size:11px;color:var(--dim);margin-bottom:4px;line-height:1.4;padding-left:8px;border-left:2px solid var(--border);}
.wk-task.primary{color:var(--text);font-weight:600;border-left-color:var(--agent);}

/* WEEKLY TASKS CARD */
.weekly-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;overflow:hidden;margin-bottom:28px;
}
.weekly-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 18px;border-bottom:1px solid var(--border);
}
.weekly-head-left{}
.weekly-head-title{font-family:'Fragment Mono',monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text);}
.weekly-head-sub{font-size:11px;color:var(--dim);margin-top:2px;}
.weekly-body{padding:10px 14px;}

/* CONTENT IDEAS CARD */
.ideas-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;overflow:hidden;margin-bottom:28px;
}
.ideas-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 18px;border-bottom:1px solid var(--border);
}
.ideas-head-left .title{font-family:'Fragment Mono',monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text);}
.ideas-head-left .sub{font-size:11px;color:var(--dim);margin-top:2px;}
.refresh-btn{
  background:var(--laugher-dim);border:1px solid rgba(244,63,94,0.25);
  border-radius:5px;color:var(--laugher);
  font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;
  padding:6px 13px;cursor:pointer;transition:all 0.15s;
}
.refresh-btn:hover{background:var(--laugher);color:#fff;}
.ptabs{display:flex;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none;}
.ptabs::-webkit-scrollbar{display:none;}
.ptab{
  font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;
  color:var(--dim);padding:11px 16px;cursor:pointer;
  border-bottom:2px solid transparent;white-space:nowrap;transition:all 0.15s;user-select:none;
}
.ptab:hover{color:var(--dim);}
.ptab.active{color:var(--laugher);border-bottom-color:var(--laugher);}
.ideas-panel{display:none;padding:14px 16px;}
.ideas-panel.active{display:block;}
.idea-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.idea-card{
  background:var(--card2);border:1px solid var(--border);
  border-radius:7px;padding:13px;transition:border-color 0.15s;
}
.idea-card:hover{border-color:var(--border2);}
.idea-num{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.1em;color:var(--dim);margin-bottom:4px;}
.idea-title{font-size:12px;font-weight:600;color:var(--text);margin-bottom:3px;line-height:1.4;}
.idea-hook{font-size:11px;color:var(--dim);line-height:1.5;font-style:italic;}
.idea-fmt{
  display:inline-block;font-family:'Fragment Mono',monospace;
  font-size:8px;letter-spacing:0.1em;text-transform:uppercase;
  padding:2px 7px;border-radius:3px;margin-top:7px;
}

/* ════════════════════════════════
   ROADMAP VIEW
════════════════════════════════ */
.roadmap-view{padding-bottom:60px;}

.rm-hero{
  border-bottom:1px solid var(--border);
  padding:36px 40px 28px;
  position:relative;overflow:hidden;
}
.rm-hero::after{
  content:'';position:absolute;top:-100px;right:-100px;
  width:500px;height:500px;
  background:radial-gradient(circle,rgba(16,185,129,0.06) 0%,transparent 65%);
  pointer-events:none;
}
.rm-label{font-family:'Fragment Mono',monospace;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--invest);margin-bottom:8px;}
.rm-h1{font-family:'Syne',sans-serif;font-size:clamp(40px,6vw,72px);font-weight:800;line-height:0.9;letter-spacing:-0.02em;color:#fff;}
.rm-h1 em{color:var(--invest);font-style:normal;}
.rm-meta{text-align:right;}
.rm-target{font-family:'Syne',sans-serif;font-size:48px;font-weight:800;color:var(--invest);line-height:1;}
.rm-target-lbl{font-family:'Fragment Mono',monospace;font-size:9px;color:var(--dim);letter-spacing:0.14em;text-transform:uppercase;}

/* 5-pillar income grid */
.income-section{padding:28px 40px;border-bottom:1px solid var(--border);}
.income-eyebrow{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--dim);margin-bottom:14px;}
.income-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.ic{background:var(--card);padding:16px 18px;position:relative;}
.ic::after{content:'';position:absolute;bottom:0;left:0;height:2px;background:var(--ic-c,#fff);width:0%;transition:width 1.2s ease;}
.ic-stream{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim);margin-bottom:4px;}
.ic-amt{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;line-height:1;color:#fff;}
.ic-note{font-size:11px;color:var(--dim);margin-top:2px;}

/* phases */
.phases{display:grid;grid-template-columns:repeat(3,1fr);}
.ph-col{border-right:1px solid var(--border);border-bottom:1px solid var(--border);}
.ph-col:last-child{border-right:none;}
.ph-head{padding:20px 24px 16px;border-bottom:1px solid var(--border);position:relative;}
.ph-head::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.ph-1 .ph-head::before{background:var(--agent);}
.ph-2 .ph-head::before{background:var(--bridge);}
.ph-3 .ph-head::before{background:var(--invest);}
.ph-num{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--dim);margin-bottom:3px;}
.ph-title{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;letter-spacing:0.02em;color:#fff;}
.ph-pill{display:inline-block;font-family:'Fragment Mono',monospace;font-size:8px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;margin-left:6px;vertical-align:middle;}
.ph-dates{font-family:'Fragment Mono',monospace;font-size:9px;color:var(--dim);margin-top:2px;}
.ph-target{font-family:'Fragment Mono',monospace;font-size:11px;margin-top:5px;}
.ph-1 .ph-target{color:var(--agent);}
.ph-2 .ph-target{color:var(--bridge);}
.ph-3 .ph-target{color:var(--invest);}

.sched{padding:16px 22px;border-bottom:1px solid var(--border);}
.sched-ttl{font-family:'Fragment Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim);margin-bottom:10px;}
.ts{display:flex;gap:10px;margin-bottom:8px;}
.ts-t{font-family:'Fragment Mono',monospace;font-size:9px;color:var(--dim);min-width:40px;padding-top:2px;flex-shrink:0;}
.ts-lbl{font-size:12px;font-weight:500;color:var(--text);line-height:1.3;}
.ts-d{font-size:11px;color:var(--dim);margin-top:1px;line-height:1.3;}
.es{color:var(--invest);font-size:9px;margin-left:3px;}

.pris{padding:14px 22px;border-bottom:1px solid var(--border);}
.pris-ttl{font-family:'Fragment Mono',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--dim);margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border);}
.pr-row{display:flex;gap:8px;margin-bottom:8px;}
.pr-dot{width:6px;height:6px;border-radius:50%;margin-top:6px;flex-shrink:0;}
.pr-body{font-size:11px;color:var(--dim);line-height:1.5;}
.pr-body strong{color:var(--text);font-weight:600;display:block;font-size:12px;margin-bottom:1px;}

.kpis{padding:14px 22px;}
.kpis-ttl{font-family:'Fragment Mono',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--dim);margin-bottom:8px;}
.kpi-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #111;}
.kpi-row:last-child{border-bottom:none;}
.kpi-lbl{font-size:11px;color:var(--dim);}
.kpi-val{font-family:'Fragment Mono',monospace;font-size:11px;}

/* bottom */
.bottom{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--border);}
.bot-panel{padding:28px 32px;border-right:1px solid var(--border);}
.bot-panel:last-child{border-right:none;}
