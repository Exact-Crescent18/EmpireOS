// ── HIGHLIGHT TODAY ──
function highlightToday() {
  const d = new Date().getDay();
  document.querySelectorAll('.power-card').forEach(c => {
    if (parseInt(c.dataset.day) === d || (d === 6 && parseInt(c.dataset.day) === 0)) {
      c.classList.add('today-card');
      const dl = c.querySelector('.pw-day');
      if (dl && !dl.querySelector('.today-pip')) dl.innerHTML += '<span class="today-pip">Today</span>';
    }
  });
  document.querySelectorAll('.wk-col').forEach(c => {
    if (parseInt(c.dataset.day) === d) c.classList.add('today-col');
  });
}

// ── COUNTDOWN ──
function tick() {
  const now = new Date();
  const t = new Date(now);
  t.setHours(18,0,0,0);
  if (now >= t) t.setDate(t.getDate()+1);
  const diff = t - now;
  const h = Math.floor(diff/3600000), m = Math.floor((diff%3600000)/60000), s = Math.floor((diff%60000)/1000);
  document.getElementById('countdown').textContent =
    `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  if (now.getHours()===18 && now.getMinutes()===0 && now.getSeconds()===0) {
    resetDaily();
    if (now.getDay()===0) {
      document.querySelectorAll('.tw[id^="tw"]').forEach(w => w.classList.remove('done-wrap'));
      localStorage.removeItem(WK); updateWeeklyBadge(); renderAllIdeas();
    }
  }
}

