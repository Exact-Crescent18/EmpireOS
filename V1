// ── CUSTOM TASKS ──
const CT_KEY = 'eos_custom_tasks_v1';
let customMode = 'daily'; // 'daily' or 'weekly'

const PILLAR_COLORS = {
  agent:   { bg: 'var(--agent-dim)',   c: 'var(--agent)',   label: '🏠 RE Agent' },
  invest:  { bg: 'var(--invest-dim)',  c: 'var(--invest)',  label: '🏢 RE Investing' },
  bridge:  { bg: 'var(--bridge-dim)',  c: 'var(--bridge)',  label: '🔗 ServiceBridge' },
  laugher: { bg: 'var(--laugher-dim)', c: 'var(--laugher)', label: '😂 Laughder' },
  trade:   { bg: 'var(--trade-dim)',   c: 'var(--trade)',   label: '📈 Trading' },
  general: { bg: 'rgba(255,255,255,0.06)', c: '#aaa',       label: '⚡ General' },
};

const TIME_LABELS = {
  '9am': '9:00 AM', '10am': '10:00 AM', '11am': '11:00 AM',
  '12pm': '12:00 PM', '1pm': '1:00 PM', '2pm': '2:00 PM',
  '3pm': '3:00 PM', '4pm': '4:00 PM', '5pm': '5:00 PM',
  'contact': '📞 Business hours',
};

function loadCustomTasks() {
  return JSON.parse(localStorage.getItem(CT_KEY) || '[]');
}
function saveCustomTasks(tasks) {
  localStorage.setItem(CT_KEY, JSON.stringify(tasks));
}

function setMode(mode) {
  customMode = mode;
  document.getElementById('tog-daily').classList.toggle('active', mode === 'daily');
  document.getElementById('tog-weekly').classList.toggle('active', mode === 'weekly');
  renderCustomList();
}

function addCustomTask() {
  const input = document.getElementById('ca-input');
  const descEl = document.getElementById('ca-desc');
  const text = input.value.trim();
  if (!text) { input.focus(); return; }
  const desc = descEl.value.trim();
  const pillar = document.getElementById('ca-pillar').value;
  const time = document.getElementById('ca-time').value;
  const tasks = loadCustomTasks();
  tasks.push({
    id: 'ct_' + Date.now(),
    text,
    desc,
    pillar,
    time,
    mode: customMode,
    done: false,
    created: Date.now(),
  });
  saveCustomTasks(tasks);
  input.value = '';
  descEl.value = '';
  closeTaskModal();
  renderCustomList();
  renderInlineSlots();
  updateProgress();
}

function toggleCustomTask(id) {
  const tasks = loadCustomTasks();
  const t = tasks.find(x => x.id === id);
  if (t) t.done = !t.done;
  saveCustomTasks(tasks);
  renderCustomList();
  renderInlineSlots();
  updateProgress();
}

function deleteCustomTask(id) {
  const tasks = loadCustomTasks().filter(x => x.id !== id);
  saveCustomTasks(tasks);
  renderCustomList();
  renderInlineSlots();
  updateProgress();
}

function renderCustomList() {
  const tasks = loadCustomTasks().filter(t => t.mode === customMode);
  const list = document.getElementById('ca-list');
  const empty = document.getElementById('ca-empty');
  if (!tasks.length) {
    list.innerHTML = '';
    list.appendChild(empty || (() => {
      const d = document.createElement('div');
      d.className = 'ca-empty'; d.id = 'ca-empty';
      d.textContent = 'No custom tasks yet — add one above.';
      return d;
    })());
    return;
  }
  const p = PILLAR_COLORS;
  list.innerHTML = tasks.map(t => {
    const pc = p[t.pillar] || p.general;
    const tl = t.time ? TIME_LABELS[t.time] || t.time : '';
    return `<div class="ct-item ${t.done ? 'ct-done' : ''}" id="li_${t.id}">
      <div class="ct-chk" onclick="toggleCustomTask('${t.id}')">✓</div>
      <div class="ct-body">
        <div class="ct-text">${escHtml(t.text)}</div>
        ${t.desc ? `<div class="ct-desc">${escHtml(t.desc)}</div>` : ''}
        <div class="ct-meta">
          <span class="ct-badge" style="background:${pc.bg};color:${pc.c}">${pc.label}</span>
          ${tl ? `<span class="ct-time">${tl}</span>` : ''}
          ${t.done ? '<span class="ct-time" style="color:var(--dim)">✓ Done</span>' : ''}
        </div>
      </div>
      <button class="ct-delete" onclick="deleteCustomTask('${t.id}')" title="Remove">×</button>
    </div>`;
  }).join('');
}

// Determine if a task belongs in morning or afternoon slot
function getSlot(task) {
  const earlyTimes = ['9am', '10am', '11am'];
  const contactTimes = ['contact'];
  if (!task.time) return 'afternoon'; // no time = afternoon default
  if (earlyTimes.includes(task.time) || contactTimes.includes(task.time)) return 'morning';
  return 'afternoon';
}

function renderInlineSlots() {
  const allTasks = loadCustomTasks();
  const dailyTasks = allTasks.filter(t => t.mode === 'daily');
  const p = PILLAR_COLORS;

  ['morning', 'afternoon'].forEach(slot => {
    const el = document.getElementById('slot-' + slot);
    if (!el) return;
    const slotTasks = dailyTasks.filter(t => getSlot(t) === slot);
    if (!slotTasks.length) { el.innerHTML = ''; return; }
    el.innerHTML = slotTasks.map(t => {
      const pc = p[t.pillar] || p.general;
      const tl = t.time ? TIME_LABELS[t.time] || t.time : 'Business hours';
      return `<div class="ct-inline ${t.done ? 'ct-done' : ''}">
        <div class="ct-chk" onclick="toggleCustomTask('${t.id}')">✓</div>
        <div class="ct-body">
          <div class="ct-text">${escHtml(t.text)}</div>
          ${t.desc ? `<div class="ct-desc">${escHtml(t.desc)}</div>` : ''}
          <div class="ct-meta">
            <span class="ct-badge" style="background:${pc.bg};color:${pc.c}">${pc.label}</span>
            <span class="ct-time">${tl}</span>
          </div>
        </div>
        <button class="ct-delete" onclick="deleteCustomTask('${t.id}')" title="Remove">×</button>
      </div>`;
    }).join('');
  });

  // Weekly custom tasks — inject into weekly section if present
  const weeklySlot = document.getElementById('slot-weekly');
  if (weeklySlot) {
    const wt = allTasks.filter(t => t.mode === 'weekly');
    weeklySlot.innerHTML = wt.map(t => {
      const pc = p[t.pillar] || p.general;
      const tl = t.time ? TIME_LABELS[t.time] || t.time : '';
      return `<div class="ct-inline ${t.done ? 'ct-done' : ''}">
        <div class="ct-chk" onclick="toggleCustomTask('${t.id}')">✓</div>
        <div class="ct-body">
          <div class="ct-text">${escHtml(t.text)}</div>
          ${t.desc ? `<div class="ct-desc">${escHtml(t.desc)}</div>` : ''}
          <div class="ct-meta">
            <span class="ct-badge" style="background:${pc.bg};color:${pc.c}">${pc.label}</span>
            ${tl ? `<span class="ct-time">${tl}</span>` : ''}
          </div>
        </div>
        <button class="ct-delete" onclick="deleteCustomTask('${t.id}')" title="Remove">×</button>
      </div>`;
    }).join('');
  }
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── PROGRESS (updated to include custom tasks) ──
const MSGS = [
  'Tap any task to expand. Check the box to mark done.',
  'Good start — keep the momentum going across all 5 pillars.',
  'Halfway there — you\'re building the empire today.',
  'Almost done — finish strong.',
  '🎉 Full day complete. This is what the empire looks like.',
];
function updateProgress() {
  const dTotal = document.querySelectorAll('.tw[id^="t"]:not([id^="tw"])').length;
  const wTotal = document.querySelectorAll('.tw[id^="tw"]').length;
  const dDone = document.querySelectorAll('.tw[id^="t"]:not([id^="tw"]).done-wrap').length;
  const wDone = document.querySelectorAll('.tw[id^="tw"].done-wrap').length;

  // Include custom tasks in count
  const allCustom = loadCustomTasks();
  const customDaily = allCustom.filter(t => t.mode === 'daily');
  const customWeekly = allCustom.filter(t => t.mode === 'weekly');
  const customDailyDone = customDaily.filter(t => t.done).length;
  const customWeeklyDone = customWeekly.filter(t => t.done).length;

  const total = dTotal + wTotal + customDaily.length + customWeekly.length;
  const done = dDone + wDone + customDailyDone + customWeeklyDone;

  document.getElementById('prog-count').textContent = `${done} / ${total}`;
  document.getElementById('prog-fill').style.width = total ? `${(done/total)*100}%` : '0%';
  const idx = total ? Math.min(Math.floor((done/total)*(MSGS.length-1)), MSGS.length-1) : 0;
  document.getElementById('prog-msg').textContent = MSGS[idx];
  const ds = document.getElementById('done-stat');
  if (ds) ds.textContent = `${dDone + customDailyDone}/${dTotal + customDaily.length}`;
}

// ── INIT ──
renderAllIdeas();
loadDaily();
loadWeekly();
renderCustomList();
renderInlineSlots();
highlightToday();
tick();
setInterval(tick, 1000);
</script>
